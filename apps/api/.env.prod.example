# TASK-DEPLOY-001: production environment template — copy to server .env and FILL
# REAL SECRETS there. NEVER commit this file with values. Everything here is
# runtime-only; the image contains no secrets.

# --- PostgreSQL (container-internal credentials; also used by compose to init) ---
JIANLI_POSTGRES_DB=jianli_prod
JIANLI_POSTGRES_USER=jianli
JIANLI_POSTGRES_PASSWORD=CHANGE_ME_strong_random_password

# --- App identity / environment ---
JIANLI_ENVIRONMENT=production
JIANLI_LOG_LEVEL=INFO
JIANLI_ALLOWED_ORIGINS=https://your-domain.com

# --- Auth secrets (generate fresh; never reuse dev values) ---
JIANLI_CSRF_HMAC_KEY=CHANGE_ME
JIANLI_RATE_LIMIT_HMAC_KEY=CHANGE_ME
JIANLI_COMPANY_FINGERPRINT_HMAC_KEY=CHANGE_ME
JIANLI_APPOINTMENT_CONFIRMATION_HMAC_KEY=CHANGE_ME

# --- Field encryption key ring (JSON; current key id + 1-2 keys) ---
JIANLI_FIELD_ENCRYPTION_CURRENT_KEY_ID=CHANGE_ME
JIANLI_FIELD_ENCRYPTION_KEYS={"CHANGE_ME":"CHANGE_ME_hex_or_base64"}

# --- SMTP (网易 163 or provider of choice; NOT the leaked code) ---
JIANLI_SMTP_HOST=smtp.163.com
JIANLI_SMTP_PORT=465
JIANLI_SMTP_USER=CHANGE_ME@163.com
JIANLI_SMTP_PASSWORD=CHANGE_ME_new_code
JIANLI_SMTP_FROM=CHANGE_ME@163.com

# --- Feishu channel (app [飞书AppID已脱敏]; reset App Secret before go-live) ---
JIANLI_FEISHU_APP_ID=[飞书AppID已脱敏]
JIANLI_FEISHU_APP_SECRET=CHANGE_ME_after_reset
JIANLI_FEISHU_BITABLE_BASE_TOKEN=Z3TubDheZaYpfcsySDecWqXcnlg
JIANLI_FEISHU_BITABLE_TABLE_ID=tbl6439HzzrFfW4Y
JIANLI_FEISHU_TIMEOUT_SECONDS=15

# --- LLM (DeepSeek or compatible; API key is runtime-only) ---
JIANLI_LLM_BASE_URL=CHANGE_ME
JIANLI_LLM_API_KEY=CHANGE_ME
JIANLI_LLM_MODEL=deepseek-v4-flash
JIANLI_LLM_TIMEOUT_SECONDS=30
JIANLI_LLM_MAX_RETRIES=3
JIANLI_LLM_EMBEDDING_BASE_URL=CHANGE_ME
JIANLI_LLM_EMBEDDING_API_KEY=CHANGE_ME
JIANLI_LLM_EMBEDDING_MODEL=CHANGE_ME
JIANLI_LLM_EMBEDDING_DIM=1024

# --- Knowledge base object storage (host dir mounted into api container) ---
JIANLI_KNOWLEDGE_STORAGE_DIR=/srv/jianli/var/knowledge
JIANLI_KB_MIN_SCORE=0.47

# --- Optional Cross-Encoder reranker (e.g. SiliconFlow /v1 + Qwen3-Reranker) ---
JIANLI_RERANK_BASE_URL=https://api.siliconflow.cn/v1
JIANLI_RERANK_API_KEY=CHANGE_ME
JIANLI_RERANK_MODEL=Qwen/Qwen3-Reranker-8B
JIANLI_RERANK_TIMEOUT_SECONDS=3
JIANLI_RERANK_TOP_N=6

# --- Anonymous grounded semantic cache + independent provider breakers ---
JIANLI_SEMANTIC_CACHE_ENABLED=true
JIANLI_SEMANTIC_CACHE_SIMILARITY=0.94
JIANLI_SEMANTIC_CACHE_TTL_SECONDS=600
JIANLI_SEMANTIC_CACHE_MAX_ENTRIES=100
JIANLI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
JIANLI_CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# --- Frontend base URL for emails ---
JIANLI_WEB_BASE_URL=https://your-domain.com
