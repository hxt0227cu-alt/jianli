# Rendered by deploy/certbot-init.sh. __DOMAIN__ is replaced only after a
# certificate has been issued successfully.
map $request_method $knowledge_upload_key {
    default "";
    POST $binary_remote_addr;
}
limit_req_zone $knowledge_upload_key zone=knowledge_upload:10m rate=2r/m;
limit_conn_zone $knowledge_upload_key zone=knowledge_upload_conn:10m;

server {
    listen 80 default_server;
    server_name _;
    access_log off;

    # Docker health checks use Host: 127.0.0.1. Keep only this exact endpoint
    # available on the default vhost; unknown-host application traffic stays closed.
    location = /nginx-health { return 200 "ok\n"; }
    location / { return 444; }
}

server {
    listen 80;
    server_name __DOMAIN__;
    access_log off;
    client_max_body_size 1m;

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location = /nginx-health { return 200 "ok\n"; }
    location = /internal/metrics { return 404; }
    location / { return 301 https://__DOMAIN__$request_uri; }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;
    access_log off;
    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 444;
}

server {
    listen 443 ssl;
    http2 on;
    server_name __DOMAIN__;
    access_log off;
    client_max_body_size 1m;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; worker-src 'self' blob:" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    root /usr/share/nginx/html;
    index index.html;

    location = /nginx-health { return 200 "ok\n"; }
    location = /internal/metrics { return 404; }

    location = /answers:stream {
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host __DOMAIN__;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    location = /slots/events {
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host __DOMAIN__;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    location = /admin/knowledge-documents {
        client_max_body_size 210m;
        client_body_timeout 120s;
        limit_req zone=knowledge_upload burst=2 nodelay;
        limit_conn knowledge_upload_conn 2;
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host __DOMAIN__;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    location ~ ^/(auth|appointments|appointment-confirmations|slots|admin|pages|conversations)(/|$) {
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host __DOMAIN__;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /assets/ { expires 30d; }
    location / { try_files $uri $uri/ /index.html; }
}
