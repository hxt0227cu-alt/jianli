#!/usr/bin/env bash
# pre-push hook (TASK-HARNESS-001)
# 仅 WSL 环境 + 本次推送涉及产品、测试或交付基础设施时运行发布门禁。
# 对实际将推送的 commit range 做 whitespace 检查；不能用工作树 diff 代替。
set -uo pipefail
remote_name="${1:-origin}"

# 非 WSL 环境：跳过
if ! grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null && [[ "$(uname -r 2>/dev/null)" != *microsoft* ]]; then
  echo "[pre-push] 非 WSL 环境：跳过 harness 评测。"
  exit 0
fi

# 应急跳过
if [[ "${JIANLI_SKIP_HOOK:-}" == "1" ]]; then
  echo "[pre-push] JIANLI_SKIP_HOOK=1：跳过 harness 评测。"
  exit 0
fi

touch_gate=0
gate_paths='^(apps/|tests/web-shell/|deploy/|scripts/|\.github/workflows/|\.gitignore$|\.dockerignore$|\.gitattributes$|playwright\.config\.ts$|vite\.config\.ts$|tsconfig(?:\.[^/]+)?\.json$|package\.json$|pnpm-lock\.yaml$|docker-compose[^/]*\.ya?ml$|Dockerfile)'
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" == "0000000000000000000000000000000000000000" ]] && continue
  if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
    base=""
    for candidate in "refs/remotes/$remote_name/HEAD" "refs/remotes/$remote_name/master" "refs/remotes/$remote_name/main"; do
      if git rev-parse --verify --quiet "$candidate" >/dev/null; then
        base="$(git merge-base "$local_sha" "$candidate" 2>/dev/null || true)"
        [ -n "$base" ] && break
      fi
    done
    if [ -n "$base" ]; then
      range="$base..$local_sha"
      git -c core.autocrlf=true diff --check "$range" 2>/dev/null || exit $?
    else
      empty_tree="$(git hash-object -t tree /dev/null)"
      git -c core.autocrlf=true diff --check "$empty_tree" "$local_sha" 2>/dev/null || exit $?
    fi
    # 新分支首次发布必须执行完整门禁，不能只检查 tip diff。
    touch_gate=1
    continue
  else
    range="$remote_sha..$local_sha"
  fi
  git -c core.autocrlf=true diff --check "$range" 2>/dev/null || exit $?
  if git diff --name-only "$range" 2>/dev/null | grep -Eq "$gate_paths"; then
    touch_gate=1
  fi
done

if [[ "$touch_gate" -eq 1 ]]; then
  echo "[pre-push] 检测到产品/测试/交付基础设施变更，运行完整发布门禁 ..."
  bash scripts/prepush.sh
  exit $?
else
  echo "[pre-push] 无门禁相关变更，跳过发布评测。"
  exit 0
fi
