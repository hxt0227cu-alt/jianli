#!/usr/bin/env bash
# pre-push hook (TASK-HARNESS-001)
# 仅 WSL 环境 + 仅本次推送的提交涉及 apps/ 时运行全量 verify；其余情况跳过。
# 注意：本仓库当前无 GitHub 远端，pre-push 实际不会触发；保留供接入远端后使用。
set -uo pipefail

# 非 WSL 环境：跳过
if ! grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null && [[ "$(uname -r 2>/dev/null)" != *microsoft* ]]; then
  echo "[pre-push] 非 WSL 环境：跳过 harness 评测。"
  exit 0
fi

# 应急跳过
if [[ "${JIANLI_SKIP_HOOK:-}" == "1" ]]; then
  echo "[pre-push] JIANLI_SKIP_HOOK=1：跳过 harness 评测。"
  exit 0
fi

touch_apps=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" == "0000000000000000000000000000000000000000" ]] && continue
  if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  if git diff --name-only "$range" 2>/dev/null | grep -q '^apps/'; then
    touch_apps=1
  fi
done

if [[ "$touch_apps" -eq 1 ]]; then
  echo "[pre-push] 检测到 apps/ 变更，运行全量 verify ..."
  bash scripts/verify.sh
  exit $?
else
  echo "[pre-push] 无 apps/ 变更，跳过 harness 评测。"
  exit 0
fi
